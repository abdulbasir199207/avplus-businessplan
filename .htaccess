# AVplus e.U. — Umleitung auf die kanonische Adresse
# Alles (http:// und avplus.at ohne www) wird dauerhaft auf
# https://www.avplus.at umgeleitet — passend zu den
# rel="canonical"-Angaben der Seiten und der Sitemap.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^avplus\.at$ [NC]
RewriteRule ^ https://www.avplus.at%{REQUEST_URI} [L,R=301]

# /index.html dauerhaft auf die kanonische Startseiten-URL / umleiten
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.avplus.at/ [L,R=301]

# .html-Endung aus allen Unterseiten-URLs entfernen
# (z. B. /medientechnik.html -> /medientechnik, dauerhaft 301)
RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.html[\s?] [NC]
RewriteRule ^([a-z-]+)\.html$ https://www.avplus.at/$1 [L,R=301]

# Saubere URLs intern auf die .html-Dateien abbilden
# (z. B. /medientechnik liefert medientechnik.html aus)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)$ $1.html [L]

# ── Alte Webseiten-Pfade (vor Relaunch Juli 2026) ──
# Bekannte Seiten der alten Webseite gezielt auf die passende
# neue Seite umleiten, damit alte Google-Treffer nicht ins
# Leere führen und ihr Ranking-Wert übergeht.
# ("konferenzr" fängt /konferenzräume in jeder Kodierung ab)
RewriteRule ^konferenzr https://www.avplus.at/medientechnik [L,R=301]

# Auffangregel: Alles, was es weder als Datei, Ordner noch als
# .html-Seite gibt (= restliche alte Pfade), dauerhaft auf die
# Startseite umleiten statt eine 404-Seite zu zeigen.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^ https://www.avplus.at/ [L,R=301]

# ── Browser-Cache für statische Dateien ──
# Bilder, Schriften und Icons bleiben 30 Tage im Browser, Skripte und
# Stylesheets nur 1 Tag (sie werden bei Änderungen nicht umbenannt).
# HTML-Seiten werden nicht zwischengespeichert, damit Änderungen sofort sichtbar sind.
# Ohne das Apache-Modul mod_expires wird der Block ignoriert.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
